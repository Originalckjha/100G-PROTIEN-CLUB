diff --git a/render.yaml b/render.yaml
new file mode 100644
index 0000000..b8688c5
--- /dev/null
+++ b/render.yaml
@@ -0,0 +1,17 @@
+# One-click deploy on Render (free plan): Dashboard → New → Blueprint → pick this repo.
+# A single web service builds the React frontend and runs the Express API,
+# so the website and /api share the same URL.
+services:
+  - type: web
+    name: 100g-protein-club
+    runtime: node
+    plan: free
+    buildCommand: npm ci --include=dev && npm run build
+    startCommand: npm start
+    healthCheckPath: /api/health
+    autoDeployTrigger: commit
+    envVars:
+      - key: NODE_ENV
+        value: production
+      - key: JWT_SECRET
+        generateValue: true
