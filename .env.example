 const router = Router();
 
 function toPublic(user: User): PublicUser {
-  const { passwordHash: _, ...pub } = user;
+  // Never send password hashes or emails to the browser (matches the PublicUser type)
+  const { passwordHash: _hash, email: _email, ...pub } = user;
   return pub;
 }
 
